---
import { getGoogleDrivePreviewUrl } from "../utils/googleDrive";

interface Props {
  node: { url?: string; caption?: string };
}

const { node } = Astro.props;
const previewUrl = node?.url ? getGoogleDrivePreviewUrl(node.url) : null;
const title = node?.caption || "Embedded video tour";
---

{
  previewUrl ? (
    <figure class="my-8">
      <div class="drive-embed">
        <iframe
          src={previewUrl}
          title={title}
          allow="autoplay"
          loading="lazy"
          allowfullscreen
        />
      </div>
      {node?.caption ? (
        <figcaption class="mt-2 text-center text-sm text-zinc-500 dark:text-zinc-400">
          {node.caption}
        </figcaption>
      ) : null}
    </figure>
  ) : null
}
