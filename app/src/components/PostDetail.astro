---
import { PortableText } from "astro-portabletext";
import Breadcrumb from "./Breadcrumb.astro";
import PortableTextGoogleDriveEmbed from "./PortableTextGoogleDriveEmbed.astro";
import PortableTextImage from "./PortableTextImage.astro";
import { formatDate } from "../utils";
import { hasGoogleDriveEmbed } from "../utils/googleDrive";
import { urlFor } from "../utils/image";
import type { Post } from "../utils/sanity";

interface Props {
  post: Post;
  parentHref?: string;
  parentLabel?: string;
}

const { post, parentHref, parentLabel } = Astro.props;

const portableTextComponents = {
  type: {
    image: PortableTextImage,
    googleDriveEmbed: PortableTextGoogleDriveEmbed,
  },
};
const resolvedTitle = post.title ?? "---";
const showMainImage = post.mainImage && !hasGoogleDriveEmbed(post.body);
const mainImageAlt =
  post.mainImage?.alt && post.mainImage.alt !== "Post image"
    ? post.mainImage.alt
    : resolvedTitle;
---

<article class="space-y-6">
  <header class="space-y-2">
    <h1>{resolvedTitle}</h1>
    <Breadcrumb
      currentLabel={resolvedTitle}
      parentHref={parentHref}
      parentLabel={parentLabel}
    />
    {post.excerpt ? <p>{post.excerpt}</p> : null}
    <p>
      <time datetime={post.publishedAt || post._createdAt}>
        {formatDate(post.publishedAt || post._createdAt)}
      </time>
    </p>
  </header>
  {
    showMainImage ? (
      <figure>
        <img
          class="max-h-[480px] w-auto rounded-lg object-cover"
          src={urlFor(post.mainImage!).width(960).height(480).fit("max").url()}
          width={960}
          height={480}
          fetchpriority="high"
          alt={mainImageAlt}
        />
      </figure>
    ) : null
  }
  <section class="prose-content">
    <PortableText value={post.body} components={portableTextComponents} />
  </section>
</article>
